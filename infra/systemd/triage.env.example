# Use absolute paths from the deployment binding for this instance.
MONAG_EXECUTABLE=/opt/monag/venv/bin/monag
MONAG_ROOT=/srv/workspaces
URTLOG_STATE_DIR=/srv/urtlog
MONAG_OQLLM_FACT_PRINCIPAL=example-producer
